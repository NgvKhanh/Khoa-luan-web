# Bien moi truong khi CHAY TEST (vitest). Khong chua bi mat that.
# DB rieng "taskflow_test" duoc tao + migrate tu dong o test/globalSetup.ts
NODE_ENV=test
PORT=4100
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public"
JWT_SECRET=test-secret-khong-dung-cho-that-0123456789abcdef
JWT_EXPIRES_IN=7d
# De trong SMTP -> nhung test da mock config/mailer nen khong gui mail that
SMTP_HOST=
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
UNSPLASH_ACCESS_KEY=
