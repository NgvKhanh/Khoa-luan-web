# ===== Cau hinh backend =====
# Copy file nay thanh .env roi sua lai gia tri cho may cua ban.

# Cong ma server Express lang nghe
PORT=4000

# Moi truong chay: development | production | test
NODE_ENV=development

# Dia chi frontend duoc phep goi API (CORS).
# Nhieu dia chi thi cach nhau bang dau phay.
CORS_ORIGIN=http://localhost:5173

# Chuoi ket noi PostgreSQL. Mac dinh khop voi docker-compose.yml o thu muc goc
# (chay "docker compose up -d" truoc khi dung).
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# Khoa bi mat de ky JWT. BAT BUOC tu tao rieng, khong dung chung, khong commit len git.
# Co the tao nhanh bang lenh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_gia_tri_nay_thanh_chuoi_bi_mat_cua_ban

# Thoi gian song cua JWT
JWT_EXPIRES_IN=7d
