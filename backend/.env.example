# ===== Cau hinh backend =====
# Copy file nay thanh .env roi sua lai gia tri cho may cua ban.

# Cong ma server Express lang nghe
PORT=4000

# Moi truong chay: development | production | test
NODE_ENV=development

# Dia chi frontend duoc phep goi API (CORS).
# Nhieu dia chi thi cach nhau bang dau phay.
CORS_ORIGIN=http://localhost:5173

# Chuoi ket noi PostgreSQL.
# - Chay backend TRUC TIEP tren may (npm run dev): dung "localhost" nhu duoi.
# - Chay backend TRONG Docker (docker compose up): docker-compose.yml tu ghi de
#   gia tri nay thanh host "postgres", khong can sua o day.
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# Khoa bi mat de ky JWT. BAT BUOC tu tao rieng, khong dung chung, khong commit len git.
# Co the tao nhanh bang lenh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_gia_tri_nay_thanh_chuoi_bi_mat_cua_ban

# Thoi gian song cua JWT
JWT_EXPIRES_IN=7d

# ===== Unsplash (thu vien anh nen bang, giong Trello) =====
# 1. Dang nhap https://unsplash.com/oauth/applications -> "New Application"
# 2. Chap nhan dieu khoan, dat ten app (vi du "TaskFlow - do an")
# 3. Copy gia tri "Access Key" dan vao day.
# De trong cung duoc: luc do chi con chon mau/gradient, khong co anh.
UNSPLASH_ACCESS_KEY=

# ===== Gui email (quen mat khau, xac minh email) =====
# De TRONG tat ca -> backend tu dung "Ethereal": mail khong toi hop thu that
# nhung in ra link xem truoc trong log. Du de phat trien va demo.
#
# Muon mail toi hop thu THAT thi dien SMTP cua nha cung cap:
#  - Gmail: bat 2FA -> tao "App Password" (https://myaccount.google.com/apppasswords)
#    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<email>  SMTP_PASS=<app password>
#  - Hoac Brevo / Resend / Mailtrap (deu co goi mien phi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Ten + dia chi hien o o "From" cua email gui di
MAIL_FROM="TaskFlow <no-reply@taskflow.local>"

# URL frontend, dung de tao link trong email (vi du link dat lai mat khau)
FRONTEND_URL=http://localhost:5173

# ===== Dang nhap bang Google =====
# 1. Vao https://console.cloud.google.com/apis/credentials -> Create Credentials
#    -> OAuth client ID -> Application type: Web application
# 2. Authorized JavaScript origins: them http://localhost:5173
# 3. Copy "Client ID" dan vao day (va vao VITE_GOOGLE_CLIENT_ID o frontend/.env)
# De trong -> endpoint /api/auth/google tra ve 503, nut Google khong hien.
GOOGLE_CLIENT_ID=

# ===== Module AI: sinh bang tu mo ta (xem AI_MODULE.md) =====
# Goi LLM qua chuan OpenAI-compatible: POST {AI_BASE_URL}/chat/completions.
# Doi nha cung cap = doi 3 bien AI_BASE_URL / AI_MODEL / AI_API_KEY, khong sua code.
# LLM chi duoc goi khi DU CA BA bien tren co gia tri. De trong bat ky bien nao ->
# module VAN CHAY (bang bo luat, khong co lop LLM) va KHONG bao gio tra 503.
#
# --- Google Gemini (mien phi) ---
# 1. Vao https://aistudio.google.com/apikey bang tai khoan Google -> Create API key
# 2. Dan key vao AI_API_KEY (CHI vao backend/.env, khong vao file nay).
# 3. Chon model dong Flash-Lite (nhe, han muc free cao). Model co nhan "Tra" trong
#    AI Studio la tra phi. Ten model doi theo thoi gian: kiem tra ten co ton tai bang
#    GET {AI_BASE_URL}/models (Authorization: Bearer <key>); sai ten -> 404.
#    Da thu that (19/09/2026): gemini-3.5-flash-lite chay tot voi json_schema.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
AI_PROVIDER_LABEL=google-gemini
#
# --- Nha cung cap khac (bo comment cac dong tuong ung de dung) ---
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
#             AI_MODEL=llama-3.3-70b-versatile
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
# Mistral:    AI_BASE_URL=https://api.mistral.ai/v1
# GitHub:     AI_BASE_URL=https://models.inference.ai.azure.com
#
# Thoi gian cho toi da 1 lan goi LLM (ms) va so ky tu dau vao toi da.
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=6000
