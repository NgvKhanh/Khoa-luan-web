// Prisma schema - phien ban skeleton: chi con xac thuc nguoi dung.
// Quy uoc: createdAt, updatedAt, deletedAt (xoa mem thay vi xoa cung).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== NGUOI DUNG =====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([email])
}
