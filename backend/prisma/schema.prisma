// Prisma schema - phien ban skeleton: chi con xac thuc nguoi dung.
// Quy uoc: createdAt, updatedAt, deletedAt (xoa mem thay vi xoa cung).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== NGUOI DUNG =====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  boards Board[]

  @@index([email])
}

// ===================== BANG (BOARD) =====================

// Bang lam viec kieu Trello. Buoc dau: thuoc thang ve nguoi tao (chua co nhom).
model Board {
  id        String    @id @default(cuid())
  ownerId   String
  name      String
  color     String    @default("#0079BF") // Mau nen the bang
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
