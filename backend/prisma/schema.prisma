// Prisma schema - phien ban skeleton: chi con xac thuc nguoi dung.
// Quy uoc: createdAt, updatedAt, deletedAt (xoa mem thay vi xoa cung).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== NGUOI DUNG =====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  boards Board[]

  @@index([email])
}

// ===================== BANG (BOARD) =====================

// Bang lam viec kieu Trello. Buoc dau: thuoc thang ve nguoi tao (chua co nhom).
model Board {
  id              String    @id @default(cuid())
  ownerId         String
  name            String
  color           String    @default("#0079BF") // Mau nen khi khong dat anh
  backgroundImage String? // Duong dan anh nen (vd /uploads/boards/xxx.jpg); null = dung mau
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lists List[]

  @@index([ownerId])
}

// ===================== DANH SACH (LIST) =====================

// Cot trong bang. "position" quyet dinh thu tu tu trai sang phai (so nho nam truoc).
model List {
  id        String    @id @default(cuid())
  boardId   String
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}
