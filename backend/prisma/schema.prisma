// Prisma schema cho website quan ly cong viec va du an
// Quy uoc chung cho MOI bang: createdAt, updatedAt, deletedAt (xoa mem thay vi xoa cung)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUM =====================

enum TeamRole {
  LEADER // Truong nhom - toan quyen quan ly nhom
  MEMBER // Thanh vien thuong
}

enum ProjectRole {
  MANAGER // Nguoi quan ly du an - duoc sua/xoa du an, quan ly thanh vien
  MEMBER // Thanh vien du an
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentType {
  FILE // File upload len server (qua Multer)
  LINK // Duong dan ngoai (vi du Google Drive)
}

enum NotificationType {
  TASK_ASSIGNED // Duoc giao viec moi
  COMMENT_ADDED // Co binh luan moi trong viec minh lien quan
  MENTIONED // Duoc nhac ten (@) trong binh luan
  DEADLINE_DUE // Cong viec sap den / da qua deadline
}

// ===================== NGUOI DUNG =====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String? // Null neu tai khoan chi dang nhap bang Google
  googleId     String?   @unique // "sub" tu Google, gan khi dang nhap Google lan dau
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")

  comments        Comment[]
  commentMentions CommentMention[]
  attachments     Attachment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]

  @@index([email])
}

// ===================== NHOM =====================

model Team {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members  TeamMember[]
  projects Project[]
}

// Thanh vien cua 1 nhom. Vai tro LEADER/MEMBER quyet dinh quyen quan ly nhom.
model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole  @default(MEMBER)
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ===================== DU AN =====================

model Project {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  tasks   Task[]
  lists   List[]

  @@index([teamId])
}

// Danh sach (cot) tren bang kieu Trello. Moi du an tu quy dinh cac cot cua rieng minh.
// "position" quyet dinh thu tu hien thi cot tu trai sang phai (so nho nam truoc).
model List {
  id        String    @id @default(cuid())
  projectId String
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// Thanh vien duoc phan cong vao 1 du an cu the (co the la tap con cua thanh vien nhom)
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  isStarred Boolean     @default(false) // Nguoi dung nay co ghim (danh sao) bang nay khong
  joinedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ===================== CONG VIEC =====================

model Task {
  id             String       @id @default(cuid())
  projectId      String
  listId         String? // Cot (List) tren bang chua the nay; null = chua thuoc cot nao
  position       Int          @default(0) // Thu tu the trong cot (so nho nam tren)
  creatorId      String
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  progress       Int          @default(0) // Phan tram tien do 0-100, kiem tra o tang ung dung
  estimatedHours Float?
  actualHours    Float?
  blockedReason  String? // Ly do khi status = BLOCKED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  list     List?   @relation(fields: [listId], references: [id], onDelete: SetNull)
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks Subtask[]

  // Cac cong viec ma task nay dang cho (task nay la ben "bi chan")
  blockedByDeps TaskDependency[] @relation("TaskBlockedBy")
  // Cac cong viec khac dang cho task nay xong (task nay la ben "chan")
  blockingDeps  TaskDependency[] @relation("TaskBlocks")

  comments    Comment[]
  attachments Attachment[]

  @@index([projectId])
  @@index([listId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

// Cong viec con (checklist) thuoc 1 Task
model Subtask {
  id        String    @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Quan he phu thuoc giua 2 Task: taskId phai cho dependsOnTaskId hoan thanh truoc
model TaskDependency {
  id              String    @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  task          Task @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskBlocks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

// ===================== BINH LUAN =====================

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  parentId  String? // Binh luan cha, dung de tra loi (reply)
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  mentions CommentMention[]

  @@index([taskId])
  @@index([parentId])
}

// Danh sach thanh vien duoc nhac ten (@) trong 1 binh luan - phuc vu gui thong bao
model CommentMention {
  id        String    @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

// ===================== DINH KEM =====================

model Attachment {
  id         String         @id @default(cuid())
  taskId     String
  uploaderId String
  type       AttachmentType
  fileName   String? // Ten file goc (khi type = FILE)
  filePath   String? // Duong dan luu tren server (khi type = FILE)
  url        String? // Duong dan lien ket ngoai (khi type = LINK)
  fileSize   Int? // Dung luong byte (khi type = FILE)
  mimeType   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
}

// ===================== LICH SU HOAT DONG =====================

// Ghi lai moi thay doi quan trong (trang thai, tien do, deadline...).
// entityType + entityId la khoa da hinh (vi du entityType="TASK", entityId=task.id)
// vi 1 bang log co the tra ve lich su cua nhieu loai doi tuong khac nhau (Task, Project...).
model ActivityLog {
  id         String    @id @default(cuid())
  entityType String // "TASK" | "PROJECT" | ...
  entityId   String
  action     String // Vi du: "STATUS_CHANGED", "PROGRESS_UPDATED", "DEADLINE_CHANGED"
  oldValue   String?
  newValue   String?
  actorId    String // Nguoi thuc hien thay doi
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

// ===================== THONG BAO =====================

model Notification {
  id        String           @id @default(cuid())
  userId    String // Nguoi nhan thong bao
  type      NotificationType
  title     String
  message   String
  link      String? // Duong dan frontend toi doi tuong lien quan
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
