// Prisma schema - phien ban skeleton: chi con xac thuc nguoi dung.
// Quy uoc: createdAt, updatedAt, deletedAt (xoa mem thay vi xoa cung).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== NGUOI DUNG =====================

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BoardVisibility {
  PRIVATE // Chi thanh vien
  WORKSPACE // Chi thanh vien (app chua co workspace nen giong PRIVATE)
  PUBLIC // Ai dang nhap co link deu xem duoc (chi doc)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  boards             Board[]
  boardMembers        BoardMember[]
  joinRequests        BoardJoinRequest[]
  cardMembers         CardMember[]
  comments            Comment[]
  checklistItems      ChecklistItem[]
  activities          Activity[]
  notifications       Notification[] @relation("NotifRecipient")
  actedNotifications  Notification[] @relation("NotifActor")

  @@index([email])
}

// Thong bao gui rieng cho tung nguoi nhan (userId), co trang thai da doc.
model Notification {
  id        String   @id @default(cuid())
  userId    String // nguoi nhan
  actorId   String // nguoi gay ra hanh dong
  type      String
  boardId   String?
  cardId    String?
  data      Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotifActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ===================== BANG (BOARD) =====================

// Bang lam viec kieu Trello. Buoc dau: thuoc thang ve nguoi tao (chua co nhom).
model Board {
  id              String    @id @default(cuid())
  ownerId         String
  name            String
  color           String    @default("#0079BF") // Mau nen khi khong dat anh
  backgroundImage String? // Duong dan anh nen (vd /uploads/boards/xxx.jpg); null = dung mau
  inviteToken     String?   @unique // Token cho link moi; null = link dang tat
  visibility      BoardVisibility @default(PRIVATE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lists        List[]
  members      BoardMember[]
  joinRequests BoardJoinRequest[]
  labels       Label[]
  activities   Activity[]

  @@index([ownerId])
}

// Yeu cau xin vao bang (khi mo link moi). Quan tri vien duyet: dong y -> them thanh vien.
model BoardJoinRequest {
  id        String            @id @default(cuid())
  boardId   String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
}

// Thanh vien cua 1 bang. OWNER = chu bang (duy nhat), MEMBER = nguoi duoc chia se.
model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  userId    String
  role      BoardRole @default(MEMBER)
  starred   Boolean   @default(false) // Nguoi dung nay danh dau sao bang chua
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

// ===================== DANH SACH (LIST) =====================

// Cot trong bang. "position" quyet dinh thu tu tu trai sang phai (so nho nam truoc).
model List {
  id        String    @id @default(cuid())
  boardId   String
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

// ===================== THE (CARD) =====================

// The nam trong 1 danh sach. "position" quyet dinh thu tu tu tren xuong.
model Card {
  id          String    @id @default(cuid())
  listId      String
  title       String
  description String?
  isDone        Boolean   @default(false) // Danh dau the da hoan thanh
  startDate     DateTime? // Ngay bat dau (null = khong dat)
  dueDate       DateTime? // Ngay het han (null = khong dat)
  coverColor    String? // Mau anh bia (hex) - null = khong co
  coverImageUrl String? // Anh bia (duong dan/URL) - uu tien hon coverColor
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  list       List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  members    CardMember[]
  labels     CardLabel[]
  checklists Checklist[]
  comments   Comment[]
  activities Activity[]

  @@index([listId])
}

// ===================== THANH VIEN THE / NHAN / CHECKLIST / BINH LUAN / HOAT DONG =====================

// Gan 1 thanh vien bang vao 1 the
model CardMember {
  id     String @id @default(cuid())
  cardId String
  userId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
}

// Nhan mau, pham vi 1 bang
model Label {
  id        String   @id @default(cuid())
  boardId   String
  name      String   @default("")
  color     String // hex #RRGGBB
  createdAt DateTime @default(now())

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@index([boardId])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model Checklist {
  id        String   @id @default(cuid())
  cardId    String
  title     String   @default("Việc cần làm")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  content     String
  isDone      Boolean   @default(false)
  position    Int       @default(0)
  assigneeId  String? // Nguoi duoc chi dinh (la thanh vien bang)
  dueDate     DateTime? // Ngay het han cua muc
  createdAt   DateTime  @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([assigneeId])
}

model Comment {
  id        String    @id @default(cuid())
  cardId    String
  userId    String
  text      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// Nhat ky hoat dong (tao the, chuyen danh sach, doi ten, danh dau xong, binh luan...)
model Activity {
  id        String   @id @default(cuid())
  boardId   String
  cardId    String?
  userId    String
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([boardId])
}
